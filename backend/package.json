{
  "name": "policyquote-backend",
  "version": "1.0.0",
  "private": true,
  "description": "PolicyQuote Lambda-style API with a knowledge-base-driven risk engine",
  "main": "dist/handler.js",
  "scripts": {
    "start": "tsx watch --clear-screen=false --include ../kb/risk-kb.json src/server.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "kb:validate": "tsx src/kb/validate-kb.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/server.js"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
